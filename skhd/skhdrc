# skhd configuration for the MacBook built-in keyboard (any keyboard works).
#
# There is no WM layer: type the chords directly.
#
# Every direct chord is `ctrl + alt` (Control + Option, both left of the space
# bar) plus a key. Used for focus H J K L, Tab, zoom F, float T, layout
# B R X V A D, Return, Spaces 1-5, and the modes M S E.
#
# Modes: enter with ctrl + alt + M/S/E, then release Ctrl+Alt and press plain
# H/J/K/L (or 1-5 in move). Esc or the plain mode key (M/S/E) leaves. Move and
# swap leave by themselves after one action (skhd -k 'escape'); resize stays
# until you leave.
#
# Collisions: tmux owns plain Alt and Alt+Shift, macOS owns Cmd+Opt and
# Ctrl+Cmd. No `C-M-` binding exists in tmux, nvim or Alacritty. VoiceOver uses
# Ctrl+Option only while it is on.

# Mode declarations must precede the bindings that enter them.
:: move @
:: swap @
:: resize @

# ---------------------------------------------------------------------------
# focus windows (falls through to the neighbouring display at the edge)
# ---------------------------------------------------------------------------

hyper - h : yabai -m window --focus west  || yabai -m display --focus west
hyper - j : yabai -m window --focus south || yabai -m display --focus south
hyper - k : yabai -m window --focus north || yabai -m display --focus north
hyper - l : yabai -m window --focus east  || yabai -m display --focus east

# Jump back to the previously focused window.
hyper - tab : yabai -m window --focus recent

# ---------------------------------------------------------------------------
# zoom and float
# ---------------------------------------------------------------------------

hyper - f : yabai -m window --toggle zoom-fullscreen

# Toggle floating; a window that becomes floating is centered at 2/3 size.
ctrl + alt - t : yabai -m window --toggle float --grid 6:6:1:1:4:4

# ---------------------------------------------------------------------------
# layout actions
# ---------------------------------------------------------------------------

ctrl + alt - b : yabai -m space --balance
ctrl + alt - r : yabai -m space --rotate 90
ctrl + alt - x : yabai -m window --toggle split
ctrl + alt - v : yabai -m space --mirror y-axis
ctrl + alt - a : yabai -m space --layout stack
ctrl + alt - d : yabai -m space --layout bsp

# ---------------------------------------------------------------------------
# launch
# ---------------------------------------------------------------------------

ctrl + alt - return : alacritty msg create-window || open -na Alacritty

# ---------------------------------------------------------------------------
# focus named Spaces (chat/terminal/web/notes/default)
# yabai's SIP-on `space --focus` (7.1.19+) is broken on macOS 27 (asmvik/yabai
# #2822, #2842), so these send macOS's own "Switch to Desktop N" shortcut
# (ctrl + N) instead. Enable them in
# System Settings > Keyboard > Keyboard Shortcuts > Mission Control. Desktop N
# is Space index N, which matches the labels in yabairc.
# ---------------------------------------------------------------------------

hyper - 1 : skhd -k "ctrl - 1"   # chat
hyper - 2 : skhd -k "ctrl - 2"   # terminal
hyper - 3 : skhd -k "ctrl - 3"   # web
hyper - 4 : skhd -k "ctrl - 4"   # notes
hyper - 5 : skhd -k "ctrl - 5"   # default

# ---------------------------------------------------------------------------
# Enter temporary modes (the plain mode key or Esc leaves again)
# ---------------------------------------------------------------------------

ctrl + alt - m ; move
ctrl + alt - s ; swap
ctrl + alt - e ; resize

# Warp/move focused window within the current Space, then return to default mode.
move < h : yabai -m window --warp west  ; skhd -k 'escape'
move < j : yabai -m window --warp south ; skhd -k 'escape'
move < k : yabai -m window --warp north ; skhd -k 'escape'
move < l : yabai -m window --warp east  ; skhd -k 'escape'

# Send the focused window to a named Space without following it. Moving a window
# to another Space uses yabai's SIP-on window-move path, which is unverified on
# macOS 27. If it fails, the window stays put, the error goes to
# /tmp/skhd_$USER.err.log, and the mode still exits.
move < 1 : yabai -m window --space chat     ; skhd -k 'escape'
move < 2 : yabai -m window --space terminal ; skhd -k 'escape'
move < 3 : yabai -m window --space web      ; skhd -k 'escape'
move < 4 : yabai -m window --space notes    ; skhd -k 'escape'
move < 5 : yabai -m window --space default  ; skhd -k 'escape'
move < m ; default
move < escape ; default

# Swap focused window, then return to default mode.
swap < h : yabai -m window --swap west  ; skhd -k 'escape'
swap < j : yabai -m window --swap south ; skhd -k 'escape'
swap < k : yabai -m window --swap north ; skhd -k 'escape'
swap < l : yabai -m window --swap east  ; skhd -k 'escape'
swap < s ; default
swap < escape ; default

# Resize stays active until you leave it, so you can tap H/J/K/L repeatedly.
# Each key grows toward its direction, or shrinks the opposite edge when already
# at the screen boundary.
resize < h : yabai -m window --resize left:-60:0  || yabai -m window --resize right:-60:0
resize < j : yabai -m window --resize bottom:0:60 || yabai -m window --resize top:0:60
resize < k : yabai -m window --resize top:0:-60   || yabai -m window --resize bottom:0:-60
resize < l : yabai -m window --resize right:60:0  || yabai -m window --resize left:60:0
resize < e ; default
resize < escape ; default
