# Interactive zsh entry point: an ordered list of fragments in custom/, one
# purpose each. The order is load-bearing; the rule for each line is written
# above it. Add a fragment by adding one line in the right place.

# core/zshenv normally sets these; fall back so a bare shell still works.
: ${XDG_CACHE_HOME:=$HOME/.cache} ${XDG_STATE_HOME:=$HOME/.local/state}
: ${ZSH_CONFIG_ROOT:=${${(%):-%x}:A:h}} ${ZSH:=$HOME/.oh-my-zsh}

# state first: it sets ZSH_STATE_DIR and ZSH_CACHE_DIR, which later fragments use.
source "$ZSH_CONFIG_ROOT/custom/state.zsh"
# history and completion before omz: Oh My Zsh reads HISTFILE and ZSH_COMPDUMP.
source "$ZSH_CONFIG_ROOT/custom/history.zsh"
source "$ZSH_CONFIG_ROOT/custom/options.zsh"
source "$ZSH_CONFIG_ROOT/custom/completion.zsh"
# cache before every _zsh_cached_init caller (pay-respects, fzf, zoxide, atuin, prompt).
source "$ZSH_CONFIG_ROOT/custom/cache.zsh"
# pay-respects after cache: its init goes through _zsh_cached_init.
source "$ZSH_CONFIG_ROOT/custom/pay-respects.zsh"
# fzf before omz:
# Register the custom widget before plugin wrappers are installed.
source "$ZSH_CONFIG_ROOT/custom/fzf.zsh"
source "$ZSH_CONFIG_ROOT/custom/omz.zsh"
# aliases and keys after omz: they override the framework's aliases and binds,
# and ^G needs fzf-cd-widget.
source "$ZSH_CONFIG_ROOT/custom/aliases.zsh"
source "$ZSH_CONFIG_ROOT/custom/keys.zsh"
# compinit-fallback after keys: its bindings must land in the emacs keymap.
source "$ZSH_CONFIG_ROOT/custom/compinit-fallback.zsh"
# zoxide after omz: compinit has to run first.
source "$ZSH_CONFIG_ROOT/custom/zoxide.zsh"
# atuin after zoxide and before prompt: its ^R bind lands after Oh My Zsh's, starship stays last.
source "$ZSH_CONFIG_ROOT/custom/atuin.zsh"
# prompt last.
source "$ZSH_CONFIG_ROOT/custom/prompt.zsh"
